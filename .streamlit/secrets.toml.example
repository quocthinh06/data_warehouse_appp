# Groq: đặt khóa ở ĐẦU Secrets, trước mọi [table]. Không commit khóa thật.
# GROQ_API_KEY = "REPLACE_IN_STREAMLIT_SECRETS"

# Mẫu, không chứa khóa thật. Local nên dùng Application Default Credentials.
# Khi deploy, điền mục này trong Secrets của nền tảng, không commit.
# [gcp_service_account]
# type = "service_account"
# project_id = "diabetes-pipeline-511509"
# private_key_id = "REPLACE_IN_HOST_SECRETS"
# private_key = """REPLACE_IN_HOST_SECRETS"""
# client_email = "REPLACE_IN_HOST_SECRETS"
# token_uri = "https://oauth2.googleapis.com/token"

# Hoặc dùng một giá trị chuỗi chứa JSON của service account trong Secrets trên Cloud:
# gcp_service_account = '''
# DÁN NGUYÊN NỘI DUNG JSON TẠI ĐÂY TRONG GIAO DIỆN SECRETS
# '''
# Chọn một trong hai cách, không khai báo cùng tên hai lần.
